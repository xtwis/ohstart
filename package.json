{
  "name": "ohstart-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "ohstart monorepo",
  "author": "Twisuki",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cli": "pnpm --filter @xtwis/ohstart build",
    "build:dev": "pnpm --filter @xtwis/ohstart-dev build",
    "check": "pnpm check:cli && pnpm check:dev",
    "check:cli": "pnpm --filter @xtwis/ohstart check",
    "check:dev": "pnpm --filter @xtwis/ohstart-dev check",
    "docs": "ohdoc dev",
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "prepare": "husky",
    "test:cli": "pnpm --filter @xtwis/ohstart test",
    "test:dev": "pnpm --filter @xtwis/ohstart-dev test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.0.0",
    "@vitest/ui": "^5.0.5",
    "@xtwis/ohdoc": "^1.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
