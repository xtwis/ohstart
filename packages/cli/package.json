{
  "name": "@xtwis/ohstart",
  "type": "module",
  "version": "0.1.0",
  "description": "ohstart CLI",
  "author": "Twisuki",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./script-api": {
      "types": "./dist/script-api.d.mts",
      "import": "./dist/script-api.mjs"
    }
  },
  "bin": {
    "ohstart": "./dist/index.mjs",
    "ohs": "./dist/index.mjs"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "fix": "pnpm -w fix",
    "lint": "pnpm -w lint",
    "prepack": "pnpm check && pnpm -w lint && pnpm test:run && pnpm build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "citty": "0.2.2",
    "esbuild": "^0.28.2"
  }
}
