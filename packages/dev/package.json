{
  "name": "@xtwis/ohstart-dev",
  "type": "module",
  "version": "1.0.1",
  "description": "Author-side toolchain for ohstart sources.",
  "author": "Twisuki <hi@twis.uk>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "readme": "README.md",
  "homepage": "https://x.twis.uk/ohstart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtwis/ohstart.git"
  },
  "bugs": {
    "url": "https://github.com/xtwis/ohstart/issues"
  },
  "keywords": [
    "cli",
    "sdk",
    "scaffold",
    "template",
    "toolchain",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/sdk.d.mts",
      "import": "./dist/sdk.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/sdk.d.mts",
  "bin": {
    "ohstart-dev": "./dist/cli.mjs",
    "ohsd": "./dist/cli.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "fix": "pnpm -w fix",
    "lint": "pnpm -w lint",
    "prepack": "pnpm check && pnpm -w lint && pnpm test:run && pnpm build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "0.2.2",
    "esbuild": "^0.28.2",
    "tinyexec": "^1.3.1"
  }
}
