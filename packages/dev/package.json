{
  "name": "@xtwis/ohstart-dev",
  "type": "module",
  "version": "0.1.0",
  "description": "ohstart dev CLI and SDK",
  "author": "Twisuki",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/api.d.mts",
      "import": "./dist/api.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/api.d.mts",
  "bin": {
    "ohstart-dev": "./dist/index.mjs",
    "ohsd": "./dist/index.mjs"
  },
